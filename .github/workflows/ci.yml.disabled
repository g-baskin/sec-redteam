# INACTIVE: keep the .disabled suffix until billing is resolved and the owner
# explicitly approves activation. GitHub does not load this as a workflow.
# Activation is manual-only initially; no push, PR, schedule or deployment trigger.
name: Local-test parity

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
        with:
          python-version: '3.12'
      - name: Install development dependencies
        run: python -m pip install -e '.[dev]'
      - name: Run existing tests without provider credentials
        run: python -m pytest
